# ---- Frontend (exposed to browser; must be prefixed with VITE_) ----
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_URL=https://your-app.vercel.app

# ---- Backend / serverless functions ----
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- SasuSync SMS provider ----
SASUSYNC_API_KEY=your-sasusync-api-key
SASUSYNC_SENDER_ID=SamleyBook
SASUSYNC_BASE_URL=https://sms.sasusync.com/smssandbox/v1/send
SASUSYNC_WEBHOOK_SECRET=your-sasusync-webhook-secret

# ---- Vercel cron (optional but recommended) ----
CRON_SECRET=generate-a-long-random-string

# ---- Local dev only ----
API_PORT=3001