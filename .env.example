# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# Connect to your Supabase Project (Settings > API > Project URL & anon/public key)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
# Server-side only (never expose to frontend)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# MOOLRE PAYMENT GATEWAY (Server-side)
MOOLRE_API_KEY="your-moolre-merchant-api-key"
MOOLRE_ACCOUNT_NUMBER="your-moolre-merchant-account"

# APP URL (for feedback/login links)
APP_URL="http://localhost:3000"

# SASUSYNC SMS CONFIGURATION (server-side only)
SASUSYNC_API_KEY="your-sasusync-api-key"
SASUSYNC_SENDER_ID="SamleyBook"
SASUSYNC_BASE_URL="https://sms.sasusync.com/smssandbox/v1/send"
SASUSYNC_WEBHOOK_SECRET="your-webhook-secret"

# Optional cron auth
CRON_SECRET="your-cron-secret"

